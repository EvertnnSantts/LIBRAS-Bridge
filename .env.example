# =============================================================
#  LIBRAS Bridge — Variáveis de Ambiente
#  Arquivo: .env.example
#
#  INSTRUÇÕES:
#    1. Copie este arquivo para '.env':
#       cp .env.example .env
#
#    2. Preencha os valores conforme seu ambiente.
#       O arquivo .env NUNCA deve ser commitado no Git.
#       Ele já está no .gitignore por padrão.
# =============================================================

# -------------------------------------------------------
# CONFIGURAÇÕES DA CÂMERA
# -------------------------------------------------------

# Índice da câmera a usar (0 = webcam padrão)
CAMERA_INDEX=0

# Resolução de captura
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# -------------------------------------------------------
# CONFIGURAÇÕES DO MEDIAPIPE
# -------------------------------------------------------

# Confiança mínima para detecção de mãos (0.0 a 1.0)
MP_DETECTION_CONFIDENCE=0.7

# -------------------------------------------------------
# CONFIGURAÇÕES DO VLIBRAS
# -------------------------------------------------------

# URL da API REST do VLibras (padrão oficial do governo)
VLIBRAS_API_URL=https://vlibras.gov.br/api/translate

# URL do widget VLibras (player com avatar 3D)
VLIBRAS_WIDGET_URL=https://vlibras.gov.br/app

# -------------------------------------------------------
# CONFIGURAÇÕES DE LOG
# -------------------------------------------------------

# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -------------------------------------------------------
# AMBIENTE
# -------------------------------------------------------

# Ambiente de execução: development ou production
APP_ENV=development
